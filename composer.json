{
  "name": "ashita-planning/laravel-error-monitor",
  "description": "A Laravel package foundation for detecting, aggregating, and normalizing HTTP 500 errors.",
  "keywords": ["laravel", "error-monitoring", "logs", "observability"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "AshitaPlanning\\LaravelErrorMonitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AshitaPlanning\\LaravelErrorMonitor\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AshitaPlanning\\LaravelErrorMonitor\\ErrorMonitorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "format": "pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
